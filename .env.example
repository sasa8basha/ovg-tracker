# ============================================
# ovg-tracker — Environment Variables
# ============================================
# Copy this to .env and fill real values:
#   cp .env.example .env
# NEVER commit .env to git.

# ---------- Environment ----------
ENV=development
DEBUG=false

# ---------- Security (REQUIRED) ----------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET=CHANGE_ME_generate_with_secrets_token_urlsafe_64

# Optional fallback key for dashboard access via URL.
# Leave empty to disable (recommended). If set, must be >= 16 chars.
DASHBOARD_KEY=

# ---------- Admin Bootstrap ----------
# Leave empty to skip auto-creation of admin user
ADMIN_USER=
ADMIN_PASS=

# ---------- Public URL ----------
PUBLIC_URL=http://localhost:8000

# ---------- CORS ----------
# Comma-separated list of trusted origins. NO wildcards allowed.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------- Database ----------
# SQLite (default for local dev)
DATABASE_URL=sqlite:///./ovg.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/ovg

# ---------- Sessions ----------
SESSION_COOKIE=ovg_session
SESSION_TTL=604800

# ---------- Rate Limiting ----------
TRACK_RATE_PER_MIN=120

# ---------- Limits ----------
MAX_SITES_PER_USER=20

# ---------- Geo / Cache ----------
GEO_LOOKUP_TIMEOUT=3.0
GEO_CACHE_TTL=86400
GEO_CACHE_MAX=50000

# ---------- Auth Tokens ----------
RESET_TOKEN_TTL=3600
VERIFY_TOKEN_TTL=86400

# ---------- Email ----------
# console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=OVG Tracker

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true

RESEND_API_KEY=

# ---------- Collector v3 ----------
COLLECTOR_V3_ENABLED=true
HANDSHAKE_TIMEOUT_MS=300
HEARTBEAT_INTERVAL_MS=10000
FINAL_BEACON_TIMEOUT_MS=2000
HANDSHAKE_RATE_PER_MIN=60
HEARTBEAT_RATE_PER_MIN=20
FINAL_RATE_PER_MIN=10
MAX_SESSIONS_PER_IP_HOUR=200

# ---------- Interstitial ----------
DEFAULT_REDIRECT_DELAY_MS=500
DEFAULT_BLOCK_THRESHOLD=90
INTERSTITIAL_MAX_WAIT_MS=1500

# ---------- Filter / Decision ----------
BOT_RISK_THRESHOLD=60

# ---------- Redis (P6, optional) ----------
REDIS_URL=redis://localhost:6379/0
